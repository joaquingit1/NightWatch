# FastAPI backend URL used by Next.js rewrites (dev default: localhost:8000)
API_BASE_URL=http://localhost:8000

# Direct browser access for SSE streams and the /ws/lidar WebSocket
# (Next.js rewrites cannot proxy either reliably)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# HLS playlist from docker-compose nginx-rtmp (booth/operator RTMP toggle)
# Publish: rtmp://localhost:1935/live/stream
NEXT_PUBLIC_RTMP_HLS_URL=http://localhost:8080/hls/stream.m3u8
