# Model and inference settings
FATIGUE_DEVICE=auto
FATIGUE_IMAGE_SIZE=640
FATIGUE_DETECTION_CONFIDENCE=0.35
FATIGUE_MAX_FACES=20
FATIGUE_MINIMUM_FACE_SIZE=30
FATIGUE_CALIBRATION_FRAMES=20
FATIGUE_WARMUP=true

# Optional tuned threshold JSON
# FATIGUE_THRESHOLD_CONFIG=/absolute/path/to/uta_rldd_threshold_results.json

# WebSocket input and annotated-output limits
FATIGUE_MAX_FRAME_BYTES=8388608
FATIGUE_MAX_FRAME_PIXELS=8294400
FATIGUE_ANNOTATED_JPEG_QUALITY=85
