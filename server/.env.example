DEMO_MODE=live
# stub | webcam | insta360 | robot | 0 | 1 | rtsp://...
CAMERA_SOURCE=webcam
SCORER=thresholds
CORS_ORIGINS=http://localhost:3000

# stub | live -- "live" streams webcam frames to fatigue_fastapi_service over
# WebSocket and uses its real EAR/PERCLOS/head-pose detection instead of the
# sine-wave stub score.
SCORER_BACKEND=live
FATIGUE_WS_URL=ws://127.0.0.1:8001/v1/streams/detect

# insta360 -- requires insta360_bridge.exe (see insta360_bridge/README.md)
# CAMERA_SOURCE=insta360
INSTA360_MJPEG_URL=http://127.0.0.1:5556/video
# INSTA360_SERIAL=

# robot -- use robot when pulling frames from the Go2 HTTP camera or remote bridge
# CAMERA_SOURCE=robot
ROBOT_CAMERA_URL=http://localhost:5555/video_feed/camera
ROBOT_STATUS_URL=http://localhost:5555/operator/status

# Emit FatigueAssessment JSON lines for the robot policy bridge (bin/NightWatch 守夜犬！.md)
ROBOT_BRIDGE_ENABLED=false
ROBOT_ASSESSMENT_PATH=data/assessments.jsonl
ROBOT_ASSESSMENT_WINDOW_SECONDS=5.0

# Nap intake form (public /form route)
INTAKE_DB_PATH=data/nightwatch.db
# Optional: require X-Intake-Operator-Key header on PATCH /api/form/responses/{id}
# INTAKE_OPERATOR_KEY=
