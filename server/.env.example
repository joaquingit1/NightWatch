DEMO_MODE=live
# stub | webcam | insta360 | robot | 0 | 1 | rtsp://...
CAMERA_SOURCE=webcam
SCORER=thresholds
CORS_ORIGINS=http://localhost:3000

# stub | live -- "live" streams webcam frames to fatigue_fastapi_service over
# WebSocket and uses its real EAR/PERCLOS/head-pose detection instead of the
# sine-wave stub score.
SCORER_BACKEND=live
FATIGUE_WS_URL=ws://127.0.0.1:8001/v1/streams/detect

# insta360 -- requires insta360_bridge.exe (see insta360_bridge/README.md)
# CAMERA_SOURCE=insta360
INSTA360_MJPEG_URL=http://127.0.0.1:5556/video
# INSTA360_SERIAL=

# robot -- use robot when pulling frames from the Go2 HTTP camera.
# ROBOT_CAMERA_URL also feeds the /video_feed/robot proxy (the /lidar page's
# first-person camera); to demo that without the robot, point it at this
# server's own pov feed: ROBOT_CAMERA_URL=http://127.0.0.1:8000/video_feed/pov
# CAMERA_SOURCE=robot
ROBOT_CAMERA_URL=http://localhost:5555/video_feed/camera
ROBOT_STATUS_URL=http://localhost:5555/operator/status
ROBOT_ASSESSMENT_URL=http://localhost:5555/operator/assessment
ROBOT_MCP_URL=http://localhost:9990/mcp

# Forward assessments to the robot and drive its intervention/escort skills.
# Keep the JSONL path enabled as a replay/audit trail.
ROBOT_BRIDGE_ENABLED=false
ROBOT_ASSESSMENT_PATH=data/assessments.jsonl
ROBOT_ASSESSMENT_WINDOW_SECONDS=5.0
ROBOT_INTERVENE_SCORE=0.65
ROBOT_ESCORT_SCORE=0.75
ROBOT_MIN_CONFIDENCE=0.55
ROBOT_MIN_QUALITY=0.55
ROBOT_MIN_OBSERVATION_SECONDS=8.0
ROBOT_CONSECUTIVE_WINDOWS=2
ROBOT_PERSON_COOLDOWN_SECONDS=180.0

# Live-map WebSocket relay (/ws/lidar). Upstream is the nightwatch MapStreamer;
# use scripts/fake_map_stream.py for development without the robot.
LIDAR_BRIDGE_WS_URL=ws://127.0.0.1:8010/ws/map

# Nap intake form (public /form route)
INTAKE_DB_PATH=data/nightwatch.db
# Optional: require X-Intake-Operator-Key on intake status changes.
# INTAKE_OPERATOR_KEY=
